{
  "_version": "1.24.0",
  "sap.app": {
    "id": "purchase.orders",
    "type": "application",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/purchase-order/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.108.0",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.ushell": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "purchase.orders.i18n.i18n"
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "purchase.orders.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "settings": {}
      }
    },
    "routing": {
      "routes": [
        {
          "pattern": ":?query:",
          "name": "List",
          "target": ["list"]
        },
        {
          "pattern": "PurchaseOrders({key})",
          "name": "Object",
          "target": ["object"]
        }
      ],
      "targets": {
        "list": {
          "type": "Component",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "entitySet": "PurchaseOrders"
            }
          }
        },
        "object": {
          "type": "Component",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "PurchaseOrders"
            }
          }
        }
      }
    }
  }
}